# Copy this file to .env and fill in real values before running
# `docker compose up --build`. Never commit the real .env file
# (it is already excluded by .gitignore).

# --- PostgreSQL ("db" service) ---
# Database name — kept identical to the local dev database (sup2i_food).
POSTGRES_DB=sup2i_food
# Database user — example format: postgres
POSTGRES_USER=postgres
# Database password — example format: Str0ng-P@ssw0rd-Example
POSTGRES_PASSWORD=

# --- Backend security (Spring Boot / "backend" service) ---
# Base64-encoded signing secret for JWT access/refresh tokens.
# Example format (32 random bytes, base64): generate with `openssl rand -base64 32`
SUP2I_JWT_SECRET_BASE64=

# Optional: logical name of the API client encoded in the JWT "aud" claim.
# If unset, the JWT issuer is used as fallback.
# SUP2I_JWT_AUDIENCE=sup2i-food-backend

# Base64-encoded encryption key used to protect MFA TOTP secrets at rest.
# Example format (32 random bytes, base64): generate with `openssl rand -base64 32`
SUP2I_MFA_ENCRYPTION_KEY_BASE64=

# --- Optional: rate limiting (defaults to enabled) ---
# SUP2I_RATE_LIMIT_ENABLED=true

# --- Optional: CORS (backend defaults to disabled if left unset) ---
# SUP2I_CORS_ENABLED=true
# Comma-separated list of allowed origins — example format:
# SUP2I_CORS_ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com
